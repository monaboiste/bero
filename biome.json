{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/astro"],
  "files": {
    "includes": ["!!**/studio-bero"]
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "performance": "off",
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.astro",
        "**/*.ts",
        "**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@test/*"],
                    "message": "Using test/* in production is prohibited."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
