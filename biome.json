{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/astro"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.astro",
      "!!**/node_modules",
      "!!**/.sanity",
      "!!**/dist",
      "!!**/.astro",
      "!!**/playwright-report",
      "!!**/test-results"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "performance": "off",
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/**/*.astro",
        "apps/web/**/*.ts",
        "apps/web/**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@test/*"],
                    "message": "Using test/* in production is prohibited."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/**/*.ts", "packages/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@bero/web", "@bero/studio"],
                    "message": "packages/* must not import from apps/*. Keep packages app-agnostic."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
