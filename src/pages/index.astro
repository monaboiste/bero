---



/**
 * SSR language dispatcher — the only non-prerendered page.
 *
 * Reads the browser's Accept-Language header via Astro.preferredLocale
 * and redirects (302) to the matching locale prefix (/pl/, /en/, /de/).
 * Falls back to the default locale (pl) when no match is found.
 */
export const prerender = false;

import { defaultLang, locales } from "@i18n/ui";

const preferred = Astro.preferredLocale;
const target =
  preferred && locales.includes(preferred as typeof locales[number])
    ? preferred
    : defaultLang;

return Astro.redirect(`/${target}/`, 302);
