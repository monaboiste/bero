---
/**
 * SSR language dispatcher — the only non-prepended page.
 */
export const prerender = false;

import { defaultLang, locales } from "@i18n/locale";

const preferred = Astro.preferredLocale;
const target =
  preferred && locales.includes(preferred as (typeof locales)[number])
    ? preferred
    : defaultLang;

return Astro.redirect(`/${target}/`, 302);
---

