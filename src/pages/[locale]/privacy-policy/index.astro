---
import SectionHeader from "@components/ui/SectionHeader.astro";
import { locales } from "@i18n/ui";
import { getLang, useTranslations } from "@i18n/utils";
import Layout from "@layouts/Layout.astro";

export const prerender = true;

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout
  title={`${t("privacy.title")} | ${t("seo.title")}`}
  description={t("privacy.description")}
  mainClass="bg-secondary pt-36 pb-20"
>
  <article
    data-testid="privacy-policy"
    class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8"
  >
    <SectionHeader title={t("privacy.title")} />

    <p class="text-center text-lg leading-relaxed text-muted-foreground">
      {t("privacy.body")}
    </p>
  </article>
</Layout>
