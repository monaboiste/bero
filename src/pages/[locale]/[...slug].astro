---
import PortfolioPage from "@components/pages/PortfolioPage.astro";
import PrivacyPolicyPage from "@components/pages/PrivacyPolicyPage.astro";
import { getLang, locales } from "@i18n/locale";
import { routes } from "@i18n/routes";

export const prerender = true;

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const langRoutes = routes[locale];
    return Object.entries(langRoutes).map(([routeKey, { slug }]) => ({
      params: { locale, slug },
      props: { routeKey },
    }));
  });
}

const { routeKey } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

{routeKey === "portfolio" && <PortfolioPage lang={lang} />}
{routeKey === "privacy-policy" && <PrivacyPolicyPage lang={lang} />}
