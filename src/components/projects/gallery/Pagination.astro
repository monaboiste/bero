---
import { ChevronLeft, ChevronRight } from "@lucide/astro";

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = "/projects" } = Astro.props;

function getPageUrl(page: number): string {
  if (page === 1) {
    return baseUrl;
  }
  return `${baseUrl}/${page}`;
}

function getPageNumbers(
  current: number,
  total: number
): (number | "ellipsis")[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const pages: (number | "ellipsis")[] = [1];

  if (current > 3) {
    pages.push("ellipsis");
  }

  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (current < total - 2) {
    pages.push("ellipsis");
  }

  pages.push(total);

  return pages;
}

const pages = getPageNumbers(currentPage, totalPages);
const prevUrl = currentPage > 1 ? getPageUrl(currentPage - 1) : null;
const nextUrl = currentPage < totalPages ? getPageUrl(currentPage + 1) : null;
---

{totalPages > 1 && (
  <nav data-testid="pagination" aria-label="Paginacja galerii" class="mt-16">
    {/* Desktop pagination */}
    <div class="hidden items-center justify-center gap-2 sm:flex">
      {/* Previous */}
      {prevUrl ? (
        <a
          href={prevUrl}
          data-testid="pagination-prev"
          class="inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm transition-colors hover:bg-accent hover:text-white"
          aria-label="Poprzednia strona"
        >
          <ChevronLeft class="h-4 w-4" />
          <span>Poprzednia</span>
        </a>
      ) : (
        <span
          class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm opacity-40"
          aria-disabled="true"
        >
          <ChevronLeft class="h-4 w-4" />
          <span>Poprzednia</span>
        </span>
      )}

      {/* Page numbers */}
      {pages.map((page, index) =>
        page === "ellipsis" ? (
          <span class="px-2 text-muted-foreground" aria-hidden="true">
            ...
          </span>
        ) : page === currentPage ? (
          <span
            data-testid={`pagination-page-${page}`}
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-accent text-sm text-white"
            aria-current="page"
            aria-label={`Strona ${page}`}
          >
            {page}
          </span>
        ) : (
          <a
            href={getPageUrl(page)}
            data-testid={`pagination-page-${page}`}
            class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border text-sm transition-colors hover:bg-accent hover:text-white"
            aria-label={`Strona ${page}`}
          >
            {page}
          </a>
        )
      )}

      {/* Next */}
      {nextUrl ? (
        <a
          href={nextUrl}
          data-testid="pagination-next"
          class="inline-flex items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm transition-colors hover:bg-accent hover:text-white"
          aria-label="Nastepna strona"
        >
          <span>Nastepna</span>
          <ChevronRight class="h-4 w-4" />
        </a>
      ) : (
        <span
          class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-4 py-2 text-sm opacity-40"
          aria-disabled="true"
        >
          <span>Nastepna</span>
          <ChevronRight class="h-4 w-4" />
        </span>
      )}
    </div>

    {/* Mobile pagination */}
    <div class="flex items-center justify-between sm:hidden">
      {prevUrl ? (
        <a
          href={prevUrl}
          class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-2 text-sm transition-colors hover:bg-accent hover:text-white"
          aria-label="Poprzednia strona"
        >
          <ChevronLeft class="h-4 w-4" />
          <span>Wstecz</span>
        </a>
      ) : (
        <span
          class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-3 py-2 text-sm opacity-40"
          aria-disabled="true"
        >
          <ChevronLeft class="h-4 w-4" />
          <span>Wstecz</span>
        </span>
      )}

      <span class="text-sm text-muted-foreground">
        Strona {currentPage} z {totalPages}
      </span>

      {nextUrl ? (
        <a
          href={nextUrl}
          class="inline-flex items-center gap-1 rounded-lg border border-border px-3 py-2 text-sm transition-colors hover:bg-accent hover:text-white"
          aria-label="Nastepna strona"
        >
          <span>Dalej</span>
          <ChevronRight class="h-4 w-4" />
        </a>
      ) : (
        <span
          class="inline-flex cursor-not-allowed items-center gap-1 rounded-lg border border-border px-3 py-2 text-sm opacity-40"
          aria-disabled="true"
        >
          <span>Dalej</span>
          <ChevronRight class="h-4 w-4" />
        </span>
      )}
    </div>
  </nav>
)}
