---
import ProjectCard from "@components/projects/ProjectCard.astro";
import type { PaginatedResult, Project } from "../../../data/projects";
import Pagination from "./Pagination.astro";
import ProjectLightbox from "./ProjectLightbox.astro";

interface Props {
  paginatedProjects: PaginatedResult<Project>;
}

// TODO: will be replaced with CMS data later
const content = {
  viewMore: "Zobacz wiecej",
};

const { paginatedProjects } = Astro.props;
const { data: projects, currentPage, totalPages } = paginatedProjects;
---

<div data-testid="projects-gallery">
  <div
    data-animate="gallery-grid"
    data-testid="projects-gallery-grid"
    class="grid gap-6 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3"
  >
    {projects.map((project) => (
      <div
        data-animate="gallery-card"
        data-project-id={project.id}
        data-project-title={project.title}
        data-project-description={project.description}
        data-project-image={project.image}
        data-project-date={project.date}
      >
        <ProjectCard
          title={project.title}
          description={project.description}
          image={project.image}
          date={project.date}
          viewMoreLabel={content.viewMore}
          projectId={project.id}
        />
      </div>
    ))}
  </div>

  <!-- Pagination -->
  <Pagination currentPage={currentPage} totalPages={totalPages} />

  <!-- Lightbox -->
  <ProjectLightbox />
</div>

<style>
  @media (scripting: enabled) {
    [data-animate="gallery-card"] {
      opacity: 0;
      transform: translateY(40px);
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  inView(
    "[data-animate='gallery-grid']",
    (grid) => {
      const cards = grid.querySelectorAll("[data-animate='gallery-card']");
      animate(
        cards,
        { opacity: 1, y: 0 },
        { duration: 0.5, ease: "easeOut", delay: stagger(0.1) }
      );
    },
    { margin: "-50px" }
  );
</script>
