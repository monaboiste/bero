---
import { ChevronLeft, ChevronRight, X } from "@lucide/astro";
---

<div
  id="project-lightbox"
  data-testid="project-lightbox"
  class="fixed inset-0 z-[100] hidden items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label="Podglad projektu"
>
  <!-- Backdrop -->
  <div
    data-testid="lightbox-backdrop"
    class="absolute inset-0 bg-black/80 backdrop-blur-sm"
    data-lightbox-close
  ></div>

  <!-- Content wrapper -->
  <div
    class="relative z-10 mx-4 flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-xl bg-card shadow-2xl sm:mx-6"
  >
    <!-- Header bar -->
    <div
      class="flex items-center justify-between border-b border-border px-4 py-3 sm:px-6"
    >
      <h3
        id="lightbox-title"
        data-testid="lightbox-title"
        class="truncate pr-4 text-lg"
      ></h3>
      <button
        data-testid="lightbox-close"
        data-lightbox-close
        class="flex-shrink-0 cursor-pointer rounded-lg p-2 transition-colors hover:bg-muted"
        aria-label="Zamknij podglad"
      >
        <X class="h-5 w-5" />
      </button>
    </div>

    <!-- Image area -->
    <div class="relative min-h-0 flex-1 overflow-hidden">
      <img
        id="lightbox-image"
        data-testid="lightbox-image"
        src=""
        alt=""
        class="h-full max-h-[60vh] w-full object-contain"
      >

      <!-- Navigation arrows - desktop -->
      <button
        id="lightbox-prev"
        data-testid="lightbox-prev"
        class="absolute top-1/2 left-3 hidden -translate-y-1/2 cursor-pointer rounded-full bg-black/50 p-2 text-white transition-colors hover:bg-black/70 sm:block"
        aria-label="Poprzedni projekt"
      >
        <ChevronLeft class="h-6 w-6" />
      </button>
      <button
        id="lightbox-next"
        data-testid="lightbox-next"
        class="absolute top-1/2 right-3 hidden -translate-y-1/2 cursor-pointer rounded-full bg-black/50 p-2 text-white transition-colors hover:bg-black/70 sm:block"
        aria-label="Nastepny projekt"
      >
        <ChevronRight class="h-6 w-6" />
      </button>
    </div>

    <!-- Info bar -->
    <div class="border-t border-border px-4 py-4 sm:px-6">
      <p
        id="lightbox-description"
        data-testid="lightbox-description"
        class="mb-2 text-sm text-muted-foreground"
      ></p>
      <div class="flex items-center justify-between">
        <span
          id="lightbox-date"
          data-testid="lightbox-date"
          class="text-xs text-muted-foreground"
        ></span>
        <!-- Mobile navigation -->
        <div class="flex items-center gap-3 sm:hidden">
          <button
            id="lightbox-prev-mobile"
            class="cursor-pointer rounded-lg border border-border p-2 transition-colors hover:bg-muted"
            aria-label="Poprzedni projekt"
          >
            <ChevronLeft class="h-4 w-4" />
          </button>
          <span
            id="lightbox-counter"
            class="text-xs text-muted-foreground"
          ></span>
          <button
            id="lightbox-next-mobile"
            class="cursor-pointer rounded-lg border border-border p-2 transition-colors hover:bg-muted"
            aria-label="Nastepny projekt"
          >
            <ChevronRight class="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { animate } from "motion";

  interface LightboxProject {
    id: string;
    title: string;
    description: string;
    image: string;
    date: string;
  }

  const lightbox = document.getElementById("project-lightbox");
  const lightboxImage = document.getElementById(
    "lightbox-image"
  ) as HTMLImageElement | null;
  const lightboxTitle = document.getElementById("lightbox-title");
  const lightboxDescription = document.getElementById("lightbox-description");
  const lightboxDate = document.getElementById("lightbox-date");
  const lightboxCounter = document.getElementById("lightbox-counter");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");
  const prevBtnMobile = document.getElementById("lightbox-prev-mobile");
  const nextBtnMobile = document.getElementById("lightbox-next-mobile");

  let projects: LightboxProject[] = [];
  let currentIndex = 0;
  let previouslyFocused: HTMLElement | null = null;

  // Touch/swipe state
  let touchStartX = 0;
  const SWIPE_THRESHOLD = 50;

  function updateLightbox(): void {
    const project = projects[currentIndex];
    if (!project) {
      return;
    }
    const requiredElements = [
      lightbox,
      lightboxImage,
      lightboxTitle,
      lightboxDescription,
      lightboxDate,
    ];
    if (requiredElements.some((el) => !el)) {
      return;
    }

    lightboxImage.src = project.image;
    lightboxImage.alt = project.title;
    lightboxTitle.textContent = project.title;
    lightboxDescription.textContent = project.description;
    lightboxDate.textContent = project.date;

    if (lightboxCounter) {
      lightboxCounter.textContent = `${currentIndex + 1} / ${projects.length}`;
    }

    // Update nav button visibility
    const hasPrev = currentIndex > 0;
    const hasNext = currentIndex < projects.length - 1;

    if (prevBtn) {
      prevBtn.classList.toggle("sm:block", hasPrev);
      prevBtn.classList.toggle("sm:hidden", !hasPrev);
    }
    if (nextBtn) {
      nextBtn.classList.toggle("sm:block", hasNext);
      nextBtn.classList.toggle("sm:hidden", !hasNext);
    }
    if (prevBtnMobile) {
      (prevBtnMobile as HTMLButtonElement).disabled = !hasPrev;
      prevBtnMobile.classList.toggle("opacity-40", !hasPrev);
    }
    if (nextBtnMobile) {
      (nextBtnMobile as HTMLButtonElement).disabled = !hasNext;
      nextBtnMobile.classList.toggle("opacity-40", !hasNext);
    }
  }

  function openLightbox(projectId: string): void {
    const index = projects.findIndex((p) => p.id === projectId);
    if (index === -1 || !lightbox) {
      return;
    }

    currentIndex = index;
    previouslyFocused = document.activeElement as HTMLElement;
    updateLightbox();

    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";

    // Animate in
    const content = lightbox.querySelector(".relative.z-10");
    if (content) {
      animate(
        content,
        { opacity: [0, 1], scale: [0.95, 1] },
        { duration: 0.25, ease: "easeOut" }
      );
    }

    // Focus trap: focus the close button
    const closeBtn = lightbox.querySelector(
      "[data-lightbox-close]"
    ) as HTMLElement | null;
    if (closeBtn) {
      closeBtn.focus();
    }
  }

  function closeLightbox(): void {
    if (!lightbox) {
      return;
    }

    const content = lightbox.querySelector(".relative.z-10");
    if (content) {
      animate(
        content,
        { opacity: [1, 0], scale: [1, 0.95] },
        { duration: 0.2, ease: "easeIn" }
      ).then(() => {
        lightbox.classList.add("hidden");
        lightbox.classList.remove("flex");
        document.body.style.overflow = "";

        if (previouslyFocused) {
          previouslyFocused.focus();
        }
      });
    } else {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    }
  }

  function goToPrev(): void {
    if (currentIndex > 0) {
      currentIndex--;
      updateLightbox();
    }
  }

  function goToNext(): void {
    if (currentIndex < projects.length - 1) {
      currentIndex++;
      updateLightbox();
    }
  }

  // Populate projects from DOM data attributes
  function initProjects(): void {
    const cards = document.querySelectorAll("[data-project-id]");
    projects = Array.from(cards)
      .map((card) => {
        const id = card.getAttribute("data-project-id");
        const title = card.getAttribute("data-project-title");
        const description = card.getAttribute("data-project-description");
        const image = card.getAttribute("data-project-image");
        const date = card.getAttribute("data-project-date");

        const values = [id, title, description, image, date];
        if (values.some((v) => !v)) {
          return null;
        }
        return { id, title, description, image, date };
      })
      .filter((p): p is LightboxProject => p !== null);
  }

  // Event listeners
  if (lightbox) {
    // Close buttons / backdrop
    const closeElements = lightbox.querySelectorAll("[data-lightbox-close]");
    for (const el of closeElements) {
      el.addEventListener("click", closeLightbox);
    }

    // Touch/swipe support
    lightbox.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].clientX;
      },
      { passive: true }
    );

    lightbox.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;

        if (Math.abs(diff) > SWIPE_THRESHOLD) {
          if (diff > 0) {
            goToNext();
          } else {
            goToPrev();
          }
        }
      },
      { passive: true }
    );
  }

  // Navigation
  if (prevBtn) {
    prevBtn.addEventListener("click", goToPrev);
  }
  if (nextBtn) {
    nextBtn.addEventListener("click", goToNext);
  }
  if (prevBtnMobile) {
    prevBtnMobile.addEventListener("click", goToPrev);
  }
  if (nextBtnMobile) {
    nextBtnMobile.addEventListener("click", goToNext);
  }

  // Keyboard
  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (!lightbox || lightbox.classList.contains("hidden")) {
      return;
    }

    if (e.key === "Escape") {
      closeLightbox();
    } else if (e.key === "ArrowLeft") {
      goToPrev();
    } else if (e.key === "ArrowRight") {
      goToNext();
    }
  });

  // Card click handler (delegated)
  document.addEventListener("click", (e: MouseEvent) => {
    const card = (e.target as HTMLElement).closest("[data-project-id]");
    if (!card) {
      return;
    }

    const projectId = card.getAttribute("data-project-id");
    if (projectId) {
      e.preventDefault();
      openLightbox(projectId);
    }
  });

  // Initialize
  initProjects();
</script>
