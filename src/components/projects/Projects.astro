---
import SectionHeader from "@components/ui/SectionHeader.astro";
import { portfolioApi } from "@lib/content/content";
import ProjectCard from "./ProjectCard.astro";

const content = {
  title: "Nasze Realizacje",
  subtitle: "Galeria wybranych projektow",
  viewAll: "Zobacz wszystkie realizacje",
};

const projects = await portfolioApi.fetchPortfolio(3);
---

<section id="projects" data-testid="projects" class="bg-secondary py-14">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader title={content.title} subtitle={content.subtitle} />

    <div
      data-animate="projects-grid"
      data-testid="projects-grid"
      class="grid gap-8 md:grid-cols-2 lg:grid-cols-3"
    >
      {projects.map((project) => (
          <ProjectCard
            data-animate="project-card"
            title={project.title}
            description={project.excerpt}
            image={project.featuredImage.url}
            date={project.date}
          />
        ))}
    </div>

    <!-- View All Button -->
    <div data-animate="projects-view-all-btn" class="mt-8 text-center">
      <a
        href="/projects"
        data-testid="projects-view-all"
        class="group inline-flex items-center rounded-lg bg-accent px-8 py-4 text-white shadow-lg transition-all duration-300 hover:bg-accent/90 hover:shadow-xl"
      >
        <span>{content.viewAll}</span>
        <svg
          class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  @media (scripting: enabled) {
    [data-animate="project-card"] {
      opacity: 0;
      transform: translateY(50px);
    }
    [data-animate="projects-view-all-btn"] {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  inView(
    "[data-animate='projects-grid']",
    (grid) => {
      const cards = grid.querySelectorAll("[data-animate='project-card']");
      animate(
        cards,
        { opacity: 1, y: 0 },
        { duration: 0.6, ease: "easeOut", delay: stagger(0.15) }
      );
    },
    { margin: "-50px" }
  );
  inView("[data-animate='projects-view-all-btn']", (element) => {
    animate(
      element,
      { opacity: [0, 1], y: [0, 20] },
      { duration: 0.6, ease: "easeOut", delay: 0.3 }
    );
  });
</script>
