---
import Card from "@components/ui/Card.astro";
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {
  title: string;
  description: string;
  image: string;
  date?: string;
}

const {
  title,
  description,
  image,
  date,
  ...rest
} = Astro.props;
---

<Card
  {...rest}
  data-testid="project-card"
  image={{ src: image, alt: title }}
  date={date}
>
  <h3
    class="mb-2 line-clamp-2 text-xl transition-colors duration-300 group-hover:text-accent"
    title={title}
  >
    {title}
  </h3>
  <p
    class="mb-2 grow line-clamp-2 text-sm text-muted-foreground"
    title={description}
  >
    {description}
  </p>
</Card>
