---
import type { JSX } from "astro/jsx-runtime";

interface LinkItem {
  label: string;
  href: string;
  testId?: string;
}

interface Props extends JSX.HTMLAttributes {
  title: string;
  links: LinkItem[];
}

const { title, links, class: className } = Astro.props;

const LOCALE_PREFIX_RE = /^\/[a-z]{2}\//;
const HASH_RE = /^\/?#/;
const SLASH_RE = /^\//;

function getTestId(link: LinkItem) {
  return (
    link.testId ??
    link.href
      .replace(LOCALE_PREFIX_RE, "/")
      .replace(HASH_RE, "")
      .replace(SLASH_RE, "")
  );
}
---

<div class={className}>
  <h3 class="mb-4 text-lg">{title}</h3>
  <ul class="space-y-2">
    {links.map((link) => (
        <li>
          <a
            href={link.href}
            data-testid={`footer-link-${getTestId(link)}`}
            class="text-sm text-primary-foreground/80 transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
  </ul>
</div>
