---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {
  image: {
    src: ImageMetadata;
    alt: string;
  };
  date?: string;
}

const { image, date, class: className, ...rest } = Astro.props;
---

<div {...rest} class:list={["group h-full", className]}>
  <div
    class="relative flex h-full flex-col overflow-hidden rounded-lg bg-card shadow-lg transition-all duration-300 hover:shadow-2xl"
  >
    <div class="relative aspect-[4/3] flex-shrink-0 overflow-hidden">
      <Image
        src={image.src}
        alt={image.alt}
        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
        widths={[400, 800]}
        sizes="(max-width: 768px) 100vw, 33vw"
        quality={80}
        loading="lazy"
      />
      <div
        class="absolute inset-0 bg-black/0 transition-all duration-300 group-hover:bg-black/20"
      ></div>

      {date && (
          <div class="absolute top-4 right-4 opacity-0 transition-all duration-300 group-hover:opacity-100">
            <span class="rounded-full bg-accent px-3 py-1 text-sm text-white shadow-lg">
              {date}
            </span>
          </div>
        )}
    </div>

    <div class="flex flex-grow flex-col p-6">
      <slot />
    </div>
  </div>
</div>
