---
interface Props {
  label: string;
  name: string;
  type?: "text" | "email" | "textarea";
  required?: boolean;
  rows?: number;
  id?: string;
}

const {
  label,
  name,
  type = "text",
  required = false,
  rows = 5,
  id,
} = Astro.props;

const fieldId = id || name;

const inputClasses =
  "w-full rounded-lg border border-border bg-background px-4 py-3 transition-colors focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none";
---

<div>
  <label for={fieldId} class="mb-2 block">
    {label}
    {required && <span class="text-accent">*</span>}
  </label>
  {type === "textarea" ? (
      <textarea
        id={fieldId}
        name={name}
        rows={rows}
        required={required}
        class={`${inputClasses} resize-none`}
      />
    ) : (
      <input
        type={type}
        id={fieldId}
        name={name}
        required={required}
        class={inputClasses}
      />
    )}
</div>
