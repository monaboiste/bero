---
export interface GalleryImage {
  src: string;
  alt: string;
  description?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: number;
  date?: string;
  class?: string;
}

const { images, columns = 3, class: className = "" } = Astro.props;
---

<div
  data-testid="masonry-gallery"
  class={`masonry-gallery ${className}`}
  style={`--masonry-columns: ${columns};`}
>
  {images.map((image) => (
      <a
        href={image.src}
        class="glightbox masonry-tile-link"
        data-gallery="masonry-gallery"
        data-type="image"
        data-description={image.description}
        data-testid="masonry-tile"
      >
        <div class="masonry-tile group relative overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-shadow duration-300 hover:shadow-lg">
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="block w-full transition-transform duration-300 group-hover:scale-105"
          />
          {image.description && (
            <div
              data-testid="masonry-tile-caption"
              class="absolute inset-x-0 bottom-0 translate-y-full bg-gradient-to-t from-black/80 to-transparent px-3 pt-8 pb-3 transition-transform duration-300 group-hover:translate-y-0"
            >
              <p class="text-sm text-white">{image.description}</p>
            </div>
          )}
        </div>
      </a>
    ))}
</div>

<style>
  .masonry-gallery {
    column-count: var(--masonry-columns, 3);
    column-gap: 1rem;
  }

  .masonry-tile-link {
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 639px) {
    .masonry-gallery {
      column-count: 1;
    }
  }
</style>

<style is:global>
  /* GLightbox skin */

  .glightbox-bero .gslide-media img,
  .glightbox-bero .gslide-image img {
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .glightbox-bero .gslide-description {
    background: var(--card);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .glightbox-bero .gdesc-inner {
    padding: 22px 20px;
  }

  .glightbox-bero .gslide-desc {
    font-family: var(--font-sans);
    color: var(--muted-foreground);
    font-size: 0.86em;
    margin-bottom: 0;
    line-height: 1.4em;
  }

  .glightbox-bero .gbtn {
    fill: var(--muted-foreground);
    background-color: var(--border);
    border-radius: var(--radius);
  }

  .glightbox-bero .gprev {
    position: absolute;
    top: -100%;
    left: 30px;
    width: 40px;
    height: 50px;
  }

  .glightbox-bero .gnext {
    position: absolute;
    top: -100%;
    right: 30px;
    width: 40px;
    height: 50px;
  }

  .glightbox-bero .gclose {
    width: 35px;
    height: 35px;
    top: 15px;
    right: 10px;
    position: absolute;
  }

  .glightbox-bero .gclose svg {
    width: 18px;
    height: auto;
  }

  .glightbox-bero .gbtn:hover {
    opacity: 1;
  }

  @media (min-width: 769px) {
    .glightbox-bero .gbtn {
      background-color: rgba(0, 0, 0, 0.32);
    }

    .glightbox-bero .gprev {
      top: 45%;
    }

    .glightbox-bero .gnext {
      top: 45%;
    }
  }

  @media (min-width: 992px) {
    .glightbox-bero .gclose {
      opacity: 0.7;
      right: 20px;
    }
  }
</style>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  function setupMasonryGallery(): void {
    const galleries = document.querySelectorAll(
      '[data-testid="masonry-gallery"]'
    );
    if (galleries.length === 0) {
      return;
    }

    GLightbox({
      selector: ".glightbox",
      skin: "bero",
      touchNavigation: true,
      loop: false,
      zoomable: true,
      draggable: true,
    });
  }

  setupMasonryGallery();
  document.addEventListener("astro:page-load", setupMasonryGallery);
</script>
