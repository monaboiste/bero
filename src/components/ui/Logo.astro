---
import CompanyLogoSvg from "@assets/logo.svg";
import { getLang, useTranslations } from "@i18n/locale";
import { useTranslatedPath } from "@i18n/path";
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {
  variant?: "light" | "dark";
  size?: "sm" | "md" | "lg";
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const { variant = "light", size = "md", class: className } = Astro.props;

// Size presets — image, text, and separator dimensions per size
const sizes = {
  sm: {
    main: "0.75rem",
    bero: "0.5rem",
    separator: "2.25rem",
    gap: "0rem",
    imageHeight: "h-9", // 36px — fits h-20 nav with padding
    containerGap: "gap-0.5",
    separatorMargin: "mr-0.5",
  },
  md: {
    main: "1.25rem",
    bero: "0.875rem",
    separator: "3.25rem",
    gap: "0rem",
    imageHeight: "h-12", // 48px
    containerGap: "gap-1",
    separatorMargin: "mr-1",
  },
  lg: {
    main: "2rem",
    bero: "1.5rem",
    separator: "5rem",
    gap: "0rem",
    imageHeight: "h-20", // 80px
    containerGap: "gap-2",
    separatorMargin: "mr-2",
  },
};

const sizeScheme = sizes[size];

// Tailwind classes for text colors based on variant
let primaryClass = "";
let secondaryClass = "text-accent";
let companyNameClass = "";
let separatorClass = "";
let svgFill = "var(--color-foreground)";

if (variant === "light") {
  primaryClass = "text-foreground";
  companyNameClass = "text-foreground";
  separatorClass = "bg-foreground";
} else if (variant === "dark") {
  primaryClass = "text-background";
  companyNameClass = "text-background";
  separatorClass = "bg-background";
}
---

<a
  href={tp("/#home")}
  data-testid="logo"
  class:list={["shrink-0 flex items-center", sizeScheme.containerGap, className]}
>
  <div class="shrink-0">
    <CompanyLogoSvg
      fill={svgFill}
      class={`${sizeScheme.imageHeight} w-auto`}
      aria-hidden="true"
    />
  </div>

  <div
    class="inline-flex items-center"
    style={{ fontFamily: "var(--font-sans)" }}
  >
    <div
      class={`${sizeScheme.separatorMargin} ${separatorClass}`}
      style={{
        width: "1px",
        height: `${sizeScheme.separator}`,
        opacity: 0.3,
        flexShrink: 0,
      }}
    ></div>

    <div class="flex flex-col" style={{ gap: `${sizeScheme.gap}` }}>
      <div
        style={{
          fontSize: `${sizeScheme.main}`,
          lineHeight: 1,
          letterSpacing: "-0.02em",
        }}
      >
        <span
          class={primaryClass}
          style={{ fontWeight: "var(--font-weight-normal)" }}
          >{t("logo.primary")}</span
        ><span
          class={secondaryClass}
          style={{ fontWeight: "var(--font-weight-bold)" }}
          >{t("logo.secondary")}</span
        >
      </div>

      <div
        class={companyNameClass}
        style={{
          fontSize: `${sizeScheme.bero}`,
          fontWeight: "var(--font-weight-bold)",
          lineHeight: 1,
        }}
      >
        BERO
      </div>
    </div>
  </div>
</a>
