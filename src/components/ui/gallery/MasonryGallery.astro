---
export interface GalleryImage {
  src: string;
  alt: string;
  description?: string;
}

interface Props {
  images: GalleryImage[];
  columns?: number;
  date?: string;
  class?: string;
}

const { images, columns = 3, class: className = "" } = Astro.props;
---

<div
  data-testid="masonry-gallery"
  class={`masonry-gallery ${className}`}
  style={`--masonry-columns: ${columns};`}
>
  {images.map((image) => (
      <a
        href={image.src}
        class="glightbox masonry-tile-link"
        data-gallery="masonry-gallery"
        data-type="image"
        data-description={image.description}
        data-animate="masonry-tile"
        data-testid="masonry-tile"
      >
        <div class="masonry-tile group relative overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-shadow duration-300 hover:shadow-lg">
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="block w-full transition-transform duration-300 group-hover:scale-105"
          />
          {image.description && (
            <div
              data-testid="masonry-tile-caption"
              class="absolute inset-x-0 bottom-0 translate-y-full bg-linear-to-t from-black/80 to-transparent px-3 pt-8 pb-3 transition-transform duration-300 group-hover:translate-y-0"
            >
              <p class="text-sm text-white">{image.description}</p>
            </div>
          )}
        </div>
      </a>
    ))}
</div>

<style>
  .masonry-gallery {
    column-count: var(--masonry-columns, 3);
    column-gap: 1rem;
  }

  .masonry-tile-link {
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 639px) {
    .masonry-gallery {
      column-count: 1;
    }
  }

  @media (scripting: enabled) {
    [data-animate="masonry-tile"] {
      opacity: 0;
      transform: translateY(40px);
    }
  }
</style>

<style is:global>
  /* GLightbox skin */

  .glightbox-bero .gslide-media img,
  .glightbox-bero .gslide-image img {
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .glightbox-bero .gslide-description {
    background: var(--popover);
    border-radius: 0 0 var(--radius) var(--radius);
  }

  .glightbox-bero .gdesc-inner {
    padding: 22px 20px;
  }

  .glightbox-bero .gslide-desc {
    font-family: var(--font-sans);
    color: var(--muted-foreground);
    font-size: 0.86em;
    margin-bottom: 0;
    line-height: 1.4em;
  }

  .glightbox-bero .gbtn {
    fill: var(--muted-foreground);
    background-color: var(--border);
    border-radius: var(--radius);
  }

  .glightbox-bero .gprev {
    position: absolute;
    top: -100%;
    left: 30px;
    width: 40px;
    height: 50px;
  }

  .glightbox-bero .gnext {
    position: absolute;
    top: -100%;
    right: 30px;
    width: 40px;
    height: 50px;
  }

  .glightbox-bero .gclose {
    width: 35px;
    height: 35px;
    top: 15px;
    right: 10px;
    position: absolute;
  }

  .glightbox-bero .gclose svg {
    width: 18px;
    height: auto;
  }

  .glightbox-bero .gbtn:hover {
    opacity: 1;
  }

  @media (min-width: 769px) {
    .glightbox-bero .gbtn {
      background-color: rgba(0, 0, 0, 0.32);
    }

    .glightbox-bero .gprev {
      top: 45%;
    }

    .glightbox-bero .gnext {
      top: 45%;
    }
  }

  @media (min-width: 992px) {
    .glightbox-bero .gclose {
      opacity: 0.7;
      right: 20px;
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  inView(
    "[data-animate='masonry-tile']",
    (tile) => {
      animate(tile, { opacity: 1, y: 0 }, { duration: 0.5, ease: "easeOut" });
    },
    { margin: "-50px" }
  );
</script>

<script>
  import GLightbox from "glightbox";
  import "glightbox/dist/css/glightbox.min.css";

  function setupMasonryGallery(): void {
    const galleries = document.querySelectorAll(
      '[data-testid="masonry-gallery"]'
    );
    if (galleries.length === 0) {
      return;
    }

    const lightbox = GLightbox({
      selector: ".glightbox",
      skin: "bero",
      // Disable GLightbox's built-in touch/drag navigation entirely.
      // Its touchNavigation relies on stale UA-sniffing (isMobile/isTouch)
      // and has an `imageZoomed` flag that can get stuck, permanently
      // blocking swipe. Its draggable binds mousedown/up/move which fires
      // alongside pointer events. Both systems would double-fire
      // nextSlide/prevSlide together with our custom handler below,
      // causing a visible "flash" (GLightbox has no guard against
      // concurrent navigation calls). We replace them with a single
      // pointer-event-based handler that works on both desktop and mobile.
      touchNavigation: false,
      draggable: false,
      loop: false,
      zoomable: false,
    });

    // Swipe / drag navigation via Pointer Events.
    // Works uniformly across desktop (mouse) and mobile (touch) because
    // PointerEvent abstracts both input types.  We guard against
    // concurrent navigations with an `isAnimating` flag so that rapid
    // swipes cannot cause a double-fire flash.
    const SWIPE_THRESHOLD = 50;
    const ANIMATION_SETTLE_MS = 400; // GLightbox slide animation is 300ms

    let startX: number | null = null;
    let startY: number | null = null;
    let tracking = false;
    let isAnimating = false;

    function onPointerDown(e: PointerEvent): void {
      if (!e.isPrimary) {
        return;
      }
      startX = e.clientX;
      startY = e.clientY;
      tracking = true;
    }

    function onPointerUp(e: PointerEvent): void {
      if (!tracking) {
        return;
      }
      if (!e.isPrimary) {
        return;
      }
      if (startX === null || startY === null) {
        return;
      }

      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      startX = null;
      startY = null;
      tracking = false;

      if (isAnimating) {
        return;
      }

      // Only act on predominantly-horizontal swipes
      if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
        isAnimating = true;
        if (dx < 0) {
          lightbox.nextSlide();
        } else {
          lightbox.prevSlide();
        }
        setTimeout(() => {
          isAnimating = false;
        }, ANIMATION_SETTLE_MS);
      }
    }

    function onPointerCancel(): void {
      startX = null;
      startY = null;
      tracking = false;
    }

    lightbox.on("open", () => {
      const slider = document.getElementById("glightbox-slider");
      if (!slider) {
        return;
      }
      slider.addEventListener("pointerdown", onPointerDown);
      slider.addEventListener("pointerup", onPointerUp);
      slider.addEventListener("pointercancel", onPointerCancel);
    });

    lightbox.on("close", () => {
      const slider = document.getElementById("glightbox-slider");
      if (!slider) {
        return;
      }
      slider.removeEventListener("pointerdown", onPointerDown);
      slider.removeEventListener("pointerup", onPointerUp);
      slider.removeEventListener("pointercancel", onPointerCancel);
      isAnimating = false;
    });
  }

  setupMasonryGallery();
  document.addEventListener("astro:page-load", setupMasonryGallery);
</script>
