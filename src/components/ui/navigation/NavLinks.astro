---
import { Camera } from "@lucide/astro";
import type { JSX } from "astro/jsx-runtime";

interface NavItem {
  label: string;
  href: string;
  highlight?: boolean;
  testId?: string;
}

interface Props extends JSX.HTMLAttributes {
  items: NavItem[];
  direction?: "row" | "column";
}

const { items, direction = "row", class: className, ...rest } = Astro.props;

function getTestId(item: NavItem) {
  return item.testId ?? item.href.replace(/^\/?#/, "").replace(/^\//, "");
}
---

<div
  {...rest}
  class:list={[direction === "row"
    ? "flex items-center space-x-8"
    : "flex flex-col space-y-4", className]}
>
  {items.map((item) =>
    item.highlight ? (
      <a
        href={item.href}
        data-testid={`nav-link-${getTestId(item)}`}
        class="nav-highlight group relative inline-flex items-center gap-2 rounded-lg px-4 py-2 transition-all duration-300 hover:bg-accent/10 hover:text-accent"
      >
        <Camera class="h-5 w-5 text-accent transition-transform duration-300 group-hover:scale-110" />
        <span>{item.label}</span>
        <span class="absolute bottom-1 left-1/2 h-0.5 w-0 -translate-x-1/2 bg-accent transition-all duration-300 group-hover:w-3/4"></span>
      </a>
    ) : (
      <a
        href={item.href}
        data-testid={`nav-link-${getTestId(item)}`}
        class="transition-colors hover:text-accent"
      >
        {item.label}
      </a>
    )
  )}
</div>
