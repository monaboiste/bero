---
import type { JSX } from "astro/jsx-runtime";

interface NavItem {
  label: string;
  href: string;
}

interface Props extends Omit<JSX.HTMLAttributes, "class"> {
  items: NavItem[];
  direction?: "row" | "column";
  class?: string;
}

const {
  items,
  direction = "row",
  class: className = "",
  ...rest
} = Astro.props;

const directionClasses =
  direction === "row"
    ? "flex items-center space-x-8"
    : "flex flex-col space-y-4";
---

<div {...rest} class={`${directionClasses} ${className}`}>
  {items.map((item) => (
      <a
        href={item.href}
        data-testid={`nav-link-${item.href.replace("#", "")}`}
        class="transition-colors hover:text-accent"
      >
        {item.label}
      </a>
    ))}
</div>
