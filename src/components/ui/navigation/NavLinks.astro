---
import type { JSX } from "astro/jsx-runtime";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface NavItem {
  label: string;
  href: string;
  highlight?: boolean;
  testId?: string;
  icon?: AstroComponentFactory;
  iconClass?: string;
}

interface Props extends JSX.HTMLAttributes {
  items: NavItem[];
  direction?: "row" | "column";
}

const { items, direction = "row", class: className, ...rest } = Astro.props;

const HASH_RE = /^\/?#/;
const SLASH_RE = /^\//;

function getTestId(item: NavItem) {
  return item.testId ?? item.href.replace(HASH_RE, "").replace(SLASH_RE, "");
}
---

<div
  {...rest}
  class:list={[direction === "row"
    ? "flex items-center space-x-8"
    : "flex flex-col space-y-4", className]}
>
  {items.map((item) => {
    const Icon = item.icon;
    return item.highlight ? (
      <a
        href={item.href}
        data-testid={`nav-link-${getTestId(item)}`}
        class:list={[
          "inline-flex items-center gap-2 rounded-lg px-4 py-2",
          direction === "column"
            ? "bg-accent/10 text-accent"
            : "group relative transition-all duration-300 hover:bg-accent/10 hover:text-accent",
        ]}
      >
        {Icon && <Icon class:list={[item.iconClass]} />}
        <span>{item.label}</span>
        {direction === "row" && (
          <span class="absolute bottom-1 left-1/2 h-0.5 w-0 -translate-x-1/2 bg-accent transition-all duration-300 group-hover:w-3/4"></span>
        )}
      </a>
    ) : (
      <a
        href={item.href}
        data-testid={`nav-link-${getTestId(item)}`}
        class:list={[
          "transition-colors hover:text-accent",
          direction === "column" && "px-4",
        ]}
      >
        {item.label}
      </a>
    );
  })}
</div>
