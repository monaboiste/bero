---
import LanguageSelector from "@components/ui/LanguageSelector.astro";
import Logo from "@components/ui/Logo.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import { getLang, useTranslatedPath, useTranslations } from "@i18n/utils";
import { Camera } from "@lucide/astro";
import MobileMenu from "./MobileMenu.astro";
import MobileMenuButton from "./MobileMenuButton.astro";
import NavLinks from "./NavLinks.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const navItems = [
  { label: t("nav.home"), href: tp("/#home") },
  { label: t("nav.projects"), href: tp("/#projects") },
  { label: t("nav.about"), href: tp("/#about") },
  { label: t("nav.contact"), href: tp("/#contact") },
  {
    label: t("nav.gallery"),
    href: tp("/portfolio"),
    highlight: true,
    testId: "gallery",
    icon: Camera,
    iconClass:
      "h-5 w-5 text-accent transition-transform duration-300 group-hover:scale-110",
  },
];
---

<nav
  data-testid="navigation"
  class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <Logo size="md" />

      <!-- Desktop Navigation -->
      <NavLinks
        items={navItems}
        direction="row"
        data-testid="nav-links-desktop"
        class="hidden lg:flex"
      />

      <!-- Right side controls (desktop) -->
      <div class="hidden items-center space-x-4 lg:flex">
        <LanguageSelector variant="dropdown" />
        <ThemeToggle id="theme-toggle" />
      </div>

      <!-- Mobile controls (hamburger + theme toggle) -->
      <MobileMenuButton />
    </div>

    <!-- Mobile menu panel (outside flex row, inside max-w container) -->
    <MobileMenu items={navItems} />
  </div>
</nav>
