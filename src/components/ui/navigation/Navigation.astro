---
import LanguageSelector from "@components/ui/LanguageSelector.astro";
import Logo from "@components/ui/Logo.astro";
import ThemeToggle from "@components/ui/ThemeToggle.astro";
import MobileMenu from "./MobileMenu.astro";
import MobileMenuButton from "./MobileMenuButton.astro";
import NavLinks from "./NavLinks.astro";

// TODO: i18n
const navItems = [
  { label: "Strona glowna", href: "#home" },
  { label: "Realizacje", href: "#projects" },
  { label: "O nas", href: "#about" },
  { label: "Kontakt", href: "#contact" },
];
---

<nav
  data-testid="navigation"
  class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <Logo size="md" />

      <!-- Desktop Navigation -->
      <div data-testid="nav-links-desktop" class="hidden md:flex">
        <NavLinks items={navItems} direction="row" />
      </div>

      <!-- Right side controls (desktop) -->
      <div class="hidden items-center space-x-4 md:flex">
        <LanguageSelector variant="dropdown" />
        <ThemeToggle id="theme-toggle" />
      </div>

      <!-- Mobile controls (hamburger + theme toggle) -->
      <MobileMenuButton />
    </div>

    <!-- Mobile menu panel (outside flex row, inside max-w container) -->
    <MobileMenu items={navItems} />
  </div>
</nav>
