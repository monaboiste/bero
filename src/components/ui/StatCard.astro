---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import IconBadge from "./IconBadge.astro";

interface Props {
  readonly stat: {
    icon: AstroComponentFactory;
    initialValueNumeric?: number;
    valueNumeric?: number | null;
    suffix: string;
    label: string;
  };
}

const {
  stat: { icon: Icon, initialValueNumeric = 0, valueNumeric, suffix, label },
} = Astro.props;

const isValueAnimatable = valueNumeric !== undefined && valueNumeric !== null;
---

<div data-animate="stat-card" data-testid="stat-card" class="text-center">
  <IconBadge size="lg" class="mb-4">
    <Icon class="h-8 w-8 text-accent" />
  </IconBadge>
  <div class="mb-2 text-4xl">
    {isValueAnimatable ? (
        <span
          data-animate="stat-card-value"
          data-initial={initialValueNumeric}
          data-target={valueNumeric}
          data-suffix={suffix}
        >
          {initialValueNumeric}
          {suffix}
        </span>
      ) : (
        <span>{suffix}</span>
      )}
  </div>
  <div class="text-sm text-muted-foreground">{label}</div>
</div>

<style>
  :root.js [data-animate="stat-card"] {
    opacity: 0;
    transform: translateY(50px);
  }
</style>

<script>
  import { animate, inView } from "motion";

  inView("[data-animate='stat-card']", () => {
    animate(
      "[data-animate='stat-card']",
      { opacity: 1, y: 0 },
      { duration: 0.6, ease: "easeOut" }
    );
  });

  const counterAnimation = () => {
    const statCards = document.querySelectorAll<HTMLElement>(
      "[data-animate='stat-card-value']"
    );
    for (const element of statCards) {
      const target = Number(element.dataset.target);
      if (Number.isNaN(target)) {
        continue;
      }

      const initial = Number(element.dataset.initial) || 0;
      const suffix = element.dataset.suffix || "";

      inView(element, () => {
        animate(initial, target, {
          duration: 2,
          ease: "circOut",
          delay: 0.2,
          onUpdate: (latest) => {
            element.textContent = Math.round(latest) + suffix;
          },
        });
      });
    }
  };
  counterAnimation();
</script>
