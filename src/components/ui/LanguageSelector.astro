---
import { Globe } from "@lucide/astro";
import type { JSX } from "astro/jsx-runtime";

interface Props extends Omit<JSX.HTMLAttributes, "class"> {
  variant?: "dropdown" | "inline";
  currentLang?: string;
  class?: string;
}

// TODO: i18n - languages will come from i18n config
const languages = [{ code: "pl", label: "Polski" }];

const {
  variant = "dropdown",
  currentLang = "pl",
  class: className,
} = Astro.props;
---

{variant === "dropdown" ? (
    <div data-testid="language-selector" class:list={["relative", className]}>
      <button
        type="button"
        id="lang-btn"
        class="flex items-center space-x-2 rounded-lg px-3 py-2 transition-colors hover:bg-muted"
      >
        <Globe class="h-5 w-5" />
        <span class="uppercase" id="current-lang">
          {currentLang}
        </span>
      </button>
      <div
        id="lang-menu"
        class="absolute right-0 mt-2 hidden w-32 overflow-hidden rounded-lg border border-border bg-card shadow-lg"
      >
        {languages.map((lang) => (
          <button
            type="button"
            data-lang={lang.code}
            class="w-full px-4 py-2 text-left transition-colors hover:bg-muted"
          >
            {lang.label}
          </button>
        ))}
      </div>
    </div>
  ) : (
    <div class:list={["flex space-x-4", className]}>
      {languages.map((lang) => (
        <button
          type="button"
          data-lang={lang.code}
          class:list={[
            "mobile-lang-btn rounded px-3 py-1",
            lang.code === currentLang
              ? "bg-accent text-accent-foreground"
              : "hover:bg-muted",
          ]}
        >
          {lang.code.toUpperCase()}
        </button>
      ))}
    </div>
  )}

<script>
  function setupLanguageSelector() {
    const langBtn = document.getElementById("lang-btn");
    const langMenu = document.getElementById("lang-menu");

    langBtn?.addEventListener("click", () => {
      langMenu?.classList.toggle("hidden");
    });

    // Close lang menu when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      const clickedInside =
        langBtn?.contains(target) || langMenu?.contains(target);
      if (!clickedInside) {
        langMenu?.classList.add("hidden");
      }
    });
  }

  setupLanguageSelector();
  document.addEventListener("astro:page-load", setupLanguageSelector);
</script>
