---
import { type Lang, languages } from "@i18n/ui";
import { getCanonicalBasePath, getLang, useTranslatedPath } from "@i18n/utils";
import { Globe } from "@lucide/astro";
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {
  variant?: "dropdown" | "inline";
}

const lang = getLang(Astro.currentLocale);
const tp = useTranslatedPath(lang);

const { variant = "dropdown", class: className } = Astro.props;

const basePath = getCanonicalBasePath(Astro.url);

const langEntries = Object.entries(languages) as [Lang, string][];
---

{variant === "dropdown" ? (
    <div data-testid="language-selector" class:list={["relative", className]}>
      <button
        type="button"
        id="lang-btn"
        class="flex items-center space-x-2 rounded-lg px-3 py-2 transition-colors hover:bg-muted"
      >
        <Globe class="h-5 w-5" />
        <span class="uppercase" id="current-lang">
          {lang}
        </span>
      </button>
      <div
        id="lang-menu"
        class="absolute right-0 mt-2 hidden w-32 overflow-hidden rounded-lg border border-border bg-card shadow-lg"
      >
        {langEntries.map(([code, label]) => (
          <a
            href={tp(basePath, code)}
            data-lang={code}
            class:list={[
              "block w-full px-4 py-2 text-left transition-colors hover:bg-muted",
              code === lang && "bg-muted font-medium",
            ]}
          >
            {label}
          </a>
        ))}
      </div>
    </div>
  ) : (
    <div class:list={["flex space-x-4", className]}>
      {langEntries.map(([code, label]) => (
        <a
          href={tp(basePath, code)}
          data-lang={code}
          class:list={[
            "mobile-lang-btn rounded px-3 py-1",
            code === lang
              ? "bg-accent text-accent-foreground"
              : "hover:bg-muted",
          ]}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </div>
  )}

<script>
  function setupLanguageSelector() {
    const langBtn = document.getElementById("lang-btn");
    const langMenu = document.getElementById("lang-menu");

    langBtn?.addEventListener("click", () => {
      langMenu?.classList.toggle("hidden");
    });

    // Close lang menu when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      const clickedInside =
        langBtn?.contains(target) || langMenu?.contains(target);
      if (!clickedInside) {
        langMenu?.classList.add("hidden");
      }
    });
  }

  setupLanguageSelector();
  document.addEventListener("astro:page-load", setupLanguageSelector);
</script>
