---
import { getLang, getTranslations } from "@i18n/locale";
import { Moon, Sun } from "@lucide/astro";
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {}

const lang = getLang(Astro.currentLocale);
const t = getTranslations(lang);

const { id = "theme-toggle", class: className } = Astro.props;
---

<button
  type="button"
  id={id}
  data-testid={id}
  class:list={["rounded-lg p-2 transition-colors hover:bg-muted", className]}
  aria-label={t("a11y.themeToggle")}
>
  <Sun class="hidden h-5 w-5 dark:block" data-testid="icon-sun" />
  <Moon class="block h-5 w-5 dark:hidden" data-testid="icon-moon" />
</button>

<script>
  function setupThemeToggle() {
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }
    };

    // Bind all theme toggle buttons
    const buttons = document.querySelectorAll("[id$='theme-toggle']");
    for (const btn of buttons) {
      // Remove old listeners by cloning
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      newBtn.addEventListener("click", toggleTheme);
    }
  }

  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
