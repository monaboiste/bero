---
import type { JSX } from "astro/jsx-runtime";

interface Props extends JSX.HTMLAttributes {
  size?: "sm" | "md" | "lg";
}

const { size = "md", class: className } = Astro.props;

const sizeClasses = {
  sm: { container: "h-10 w-10", icon: "h-5 w-5" },
  md: { container: "h-12 w-12", icon: "h-6 w-6" },
  lg: { container: "h-16 w-16", icon: "h-8 w-8" },
};

const scheme = sizeClasses[size];
---

<div
  data-icon-size={scheme.icon}
  class:list={["inline-flex items-center justify-center rounded-full bg-accent/10", className]}
>
  <slot />
</div>
