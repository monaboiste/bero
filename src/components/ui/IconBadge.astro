---
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;

const sizeClasses = {
  sm: { container: "h-10 w-10", icon: "h-5 w-5" },
  md: { container: "h-12 w-12", icon: "h-6 w-6" },
  lg: { container: "h-16 w-16", icon: "h-8 w-8" },
};

const scheme = sizeClasses[size];
---

<div
  class={`inline-flex items-center justify-center rounded-full bg-accent/10 ${scheme.container} ${className}`}
  data-icon-size={scheme.icon}
>
  <slot />
</div>
