---
import { getLang, useTranslations } from "@i18n/locale";
import { getAlternateUrls, getCanonicalUrl, getSiteUrl } from "@i18n/path";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  robots?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const siteUrl = getSiteUrl(Astro.site);

const {
  title = t("seo.title"),
  description = t("seo.description"),
  image = `${siteUrl}/seo-image.png`,
  type = "website",
  robots = "index, follow",
} = Astro.props;

const canonicalUrl = getCanonicalUrl(Astro.site, Astro.url);
const alternates = getAlternateUrls(Astro.url);
---

<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<link rel="canonical" href={canonicalUrl}>
<link rel="sitemap" href="/sitemap-index.xml">

{alternates.map(({ locale, href }) => (
  <link rel="alternate" hreflang={locale} href={href} />
))}
<link rel="alternate" hreflang="x-default" href="/">

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={image}>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
