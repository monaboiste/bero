---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLang, locales, useTranslations } from "@i18n/locale";
import {
  getCanonicalBasePath,
  getRouteFromUrl,
  useTranslatedPath,
} from "@i18n/path";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const {
  title = t("seo.title"),
  description = t("seo.description"),
  image,
  type = "website",
} = Astro.props;

const canonicalRoute = getRouteFromUrl(Astro.url);
const basePath = getCanonicalBasePath(Astro.url);

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const alternates = locales.map((locale) => {
  const tp = useTranslatedPath(locale);
  const href = canonicalRoute
    ? tp(basePath, locale)
    : getRelativeLocaleUrl(locale, basePath);
  return { locale, href };
});
---

<!-- SEO -->
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalUrl}>

<!-- Hreflang alternate links -->
{alternates.map(({ locale, href }) => (
  <link rel="alternate" hreflang={locale} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={basePath}>

<!-- Open Graph -->
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalUrl}>
{image && <meta property="og:image" content={image} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
{image && <meta name="twitter:image" content={image} />}
