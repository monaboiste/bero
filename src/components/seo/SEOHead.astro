---
import { getLang, getOgLocale, getTranslations, type Lang } from "@i18n/locale";
import { getAlternateUrls, getCanonicalUrl, getSiteUrl } from "@i18n/path";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  robots?: string;
}

const siteUrl = getSiteUrl(Astro.site);
const lang = getLang(Astro.currentLocale);
const t = getTranslations(lang);

const {
  title = t("seo.title"),
  description = t("seo.description"),
  image = `${siteUrl}/seo-image.png`,
  type = "website",
  robots = "index, follow",
} = Astro.props;

const canonicalUrl = getCanonicalUrl(Astro.site, Astro.url);
const alternateUrls = getAlternateUrls(Astro.url);

const ogLocale = getOgLocale(lang);
const ogLocaleAlternates = alternateUrls
  .filter(({ locale }) => locale !== lang)
  .map(({ locale }) => getOgLocale(locale as Lang));
---

<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={robots}>
<link rel="canonical" href={canonicalUrl}>
<link rel="sitemap" href="/sitemap-index.xml">

{alternateUrls.map(({ locale, href }) => (
  <link rel="alternate" hreflang={locale} href={href} />
))}
<link rel="alternate" hreflang="x-default" href="/">

<meta property="og:site_name" content={t("seo.title")}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={type}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={image}>
<meta property="og:locale" content={ogLocale}>
{ogLocaleAlternates.map((alt) => (
  <meta property="og:locale:alternate" content={alt} />
))}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
