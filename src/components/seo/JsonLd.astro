---
import type {
  BreadcrumbList,
  Graph,
  HomeAndConstructionBusiness,
  Organization,
  Thing,
  WebSite,
} from "schema-dts";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs } = Astro.props;

const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).href.replace(
  /\/$/,
  ""
);

const BUSINESS = {
  name: "Studio Tapicerskie BERO",
  streetAddress: "Św. Wojciech 70",
  locality: "Międzyrzecz",
  postalCode: "66-300",
  country: "PL",
  telephone: "+48 720 770 960",
  email: "szumnyfilip@gmail.com",
  latitude: 52.448_008_1,
  longitude: 15.547_803_8,
  logo: `${siteUrl}/favicon.svg`,
  image: `${siteUrl}/seo-image.png`,
  sameAs: [
    "https://www.facebook.com/StudioTapicerskieBERO",
    "https://www.instagram.com/studio.tapicerskie.bero",
  ] as const,
};

const organization: Organization = {
  "@type": "Organization",
  name: BUSINESS.name,
  url: siteUrl,
  logo: BUSINESS.logo,
  sameAs: [...BUSINESS.sameAs],
};

const localBusiness: HomeAndConstructionBusiness = {
  "@type": "HomeAndConstructionBusiness",
  name: BUSINESS.name,
  url: siteUrl,
  telephone: BUSINESS.telephone,
  email: BUSINESS.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.streetAddress,
    addressLocality: BUSINESS.locality,
    postalCode: BUSINESS.postalCode,
    addressCountry: BUSINESS.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: BUSINESS.latitude,
    longitude: BUSINESS.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "https://schema.org/Monday",
      "https://schema.org/Tuesday",
      "https://schema.org/Wednesday",
      "https://schema.org/Thursday",
      "https://schema.org/Friday",
    ],
    opens: "09:00",
    closes: "17:00",
  },
  logo: BUSINESS.logo,
  image: BUSINESS.image,
  sameAs: [...BUSINESS.sameAs],
};

const website: WebSite = {
  "@type": "WebSite",
  name: BUSINESS.name,
  url: siteUrl,
};

const breadcrumbList: BreadcrumbList | null = breadcrumbs
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem" as const,
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : null;

const graph: Thing[] = [organization];

if (!breadcrumbs) {
  graph.push(localBusiness, website);
}

if (breadcrumbList) {
  graph.push(breadcrumbList);
}

const jsonLd: Graph = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
