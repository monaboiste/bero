---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import IconBadge from "../ui/IconBadge.astro";

interface ContactItem {
  icon: AstroComponentFactory;
  label: string;
}

interface Props {
  items: ContactItem[];
  class?: string;
}

const { items, class: className = "" } = Astro.props;
---

<div data-testid="contact-info" class={`space-y-8 ${className}`}>
  {items.map((info) => {
      const Icon = info.icon;
      return (
        <div class="flex items-center space-x-4">
          <div class="shrink-0">
            <IconBadge size="md">
              <Icon class="h-6 w-6 text-accent" />
            </IconBadge>
          </div>
          <div class="flex-1">
            <p class="text-lg">{info.label}</p>
          </div>
        </div>
      );
    })}
</div>
