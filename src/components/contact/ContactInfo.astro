---
import IconBadge from "@components/ui/IconBadge.astro";
import type { JSX } from "astro/jsx-runtime";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface ContactItem {
  icon: AstroComponentFactory;
  label: string;
}

interface Props extends Omit<JSX.HTMLAttributes, "class"> {
  items: ContactItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div
  data-animate="contact-info"
  data-testid="contact-info"
  class:list={["space-y-8", className]}
>
  {items.map((info) => {
      const Icon = info.icon;
      return (
        <div
          data-animate="contact-info-row"
          data-testid="contact-info-row"
          class="flex items-center space-x-4"
        >
          <div class="shrink-0">
            <IconBadge size="md">
              <Icon class="h-6 w-6 text-accent" />
            </IconBadge>
          </div>
          <div class="flex-1">
            <p class="text-lg">{info.label}</p>
          </div>
        </div>
      );
    })}
</div>

<style>
  @media (scripting: enabled) {
    [data-animate="contact-info-row"] {
      opacity: 0;
      transform: translateX(-20px);
    }
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  inView(
    "[data-animate='contact-info']",
    (info) => {
      const rows = info.querySelectorAll<HTMLElement>(
        "[data-animate='contact-info-row']"
      );

      animate(
        rows,
        { opacity: 1, x: 0 },
        { duration: 0.5, ease: "easeOut", delay: stagger(0.2) }
      );
    },
    { margin: "-50px" }
  );
</script>
