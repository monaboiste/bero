---
import { Image } from "astro:assets";
import { Globe, Menu, Moon, Sun, X } from "@lucide/astro";
import logoLight from "../assets/logo/light.svg";
import logoDark from "../assets/logo/dark.svg";

// TODO: 18in
const navItems = [
  { label: "Strona główna", href: "#home" },
  { label: "Realizacje", href: "#projects" },
  { label: "O nas", href: "#about" },
  { label: "Kontakt", href: "#contact" },
];
---

<nav
  class="fixed top-0 right-0 left-0 z-50 border-b border-border bg-background/95 backdrop-blur-sm"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <!-- Logo -->
      <a href="#home" class="shrink-0">
        <Image
          src={logoLight}
          alt="BERO"
          class="h-12 w-auto dark:hidden"
          width={180}
          format="webp"
          quality={48}
        />
        <Image
          src={logoDark}
          alt="BERO"
          class="hidden h-12 w-auto dark:block"
          width={180}
          format="webp"
          quality={48}
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden items-center space-x-8 md:flex">
        {
          navItems.map((item) => (
            <a href={item.href} class="transition-colors hover:text-accent">
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Right side controls -->
      <div class="hidden items-center space-x-4 md:flex">
        <!-- Language Selector -->
        <div class="relative">
          <button
            type="button"
            id="lang-btn"
            class="flex items-center space-x-2 rounded-lg px-3 py-2 transition-colors hover:bg-muted"
          >
            <Globe class="h-5 w-5" />
            <span class="uppercase" id="current-lang">PL</span>
          </button>
          <div
            id="lang-menu"
            class="absolute right-0 mt-2 hidden w-32 overflow-hidden rounded-lg border border-border bg-card shadow-lg"
          >
            <button
              type="button"
              data-lang="pl"
              class="w-full px-4 py-2 text-left transition-colors hover:bg-muted"
            >
              Polski
            </button>
            <button
              type="button"
              data-lang="en"
              class="w-full px-4 py-2 text-left transition-colors hover:bg-muted"
            >
              English
            </button>
          </div>
        </div>

        <!-- Dark Mode Toggle -->
        <button
          type="button"
          id="theme-toggle"
          class="rounded-lg p-2 transition-colors hover:bg-muted"
          aria-label="Przełącz motyw"
        >
          <Sun class="hidden h-5 w-5 dark:block" />
          <Moon class="block h-5 w-5 dark:hidden" />
        </button>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center space-x-2 md:hidden">
        <button
          type="button"
          id="mobile-theme-toggle"
          class="rounded-lg p-2 transition-colors hover:bg-muted"
          aria-label="Przełącz motyw"
        >
          <Sun class="hidden h-5 w-5 dark:block" />
          <Moon class="block h-5 w-5 dark:hidden" />
        </button>
        <button
          type="button"
          id="mobile-menu-btn"
          class="rounded-lg p-2 transition-colors hover:bg-muted"
          aria-label="Menu"
        >
          <Menu class="h-6 w-6" id="menu-icon" />
          <X class="hidden h-6 w-6" id="close-icon" />
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden border-t border-border py-4 md:hidden">
      <div class="flex flex-col space-y-4">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="text-left transition-colors hover:text-accent"
            >
              {item.label}
            </a>
          ))
        }
        <div class="flex space-x-4 border-t border-border pt-4">
          <button
            type="button"
            data-lang="pl"
            class="mobile-lang-btn rounded bg-accent px-3 py-1 text-accent-foreground"
          >
            PL
          </button>
          <button
            type="button"
            data-lang="en"
            class="mobile-lang-btn rounded px-3 py-1 hover:bg-muted"
          >
            EN
          </button>
          <button
            type="button"
            data-lang="de"
            class="mobile-lang-btn rounded px-3 py-1 hover:bg-muted"
          >
            DE
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  const setupNavigation = () => {
    // Mobile menu toggle
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    mobileMenuBtn?.addEventListener("click", () => {
      mobileMenu?.classList.toggle("hidden");
      menuIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    });

    // Close mobile menu when clicking a link
    const links = mobileMenu?.querySelectorAll("a") ?? [];
    for (const link of links) {
      link.addEventListener("click", () => {
        mobileMenu?.classList.add("hidden");
        menuIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      });
    }

    // Theme toggle
    const toggleTheme = () => {
      const isDark = document.documentElement.classList.contains("dark");
      if (isDark) {
        document.documentElement.classList.remove("dark");
        localStorage.setItem("theme", "light");
      } else {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      }
    };

    document
      .getElementById("theme-toggle")
      ?.addEventListener("click", toggleTheme);
    document
      .getElementById("mobile-theme-toggle")
      ?.addEventListener("click", toggleTheme);

    // Language selector
    const langBtn = document.getElementById("lang-btn");
    const langMenu = document.getElementById("lang-menu");

    langBtn?.addEventListener("click", () => {
      langMenu?.classList.toggle("hidden");
    });

    // Close lang menu when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      const clickedInside =
        langBtn?.contains(target) || langMenu?.contains(target);
      if (!clickedInside) {
        langMenu?.classList.add("hidden");
      }
    });
  };

  setupNavigation();
  document.addEventListener("astro:page-load", setupNavigation);
</script>
