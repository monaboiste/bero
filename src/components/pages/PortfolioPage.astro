---
import GridGallery from "@components/ui/gallery/GridGallery.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import TagFilter from "@components/ui/TagFilter.astro";
import { type Lang, useTranslations } from "@i18n/locale";
import { getSiteUrl, useTranslatedPath } from "@i18n/path";
import Layout from "@layouts/Layout.astro";
import { createPortfolioApi } from "@lib/content/content";
import { PORTFOLIO_TAG_KEYS } from "@lib/content/tags";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

const siteUrl = getSiteUrl(Astro.site);

const breadcrumbs = [
  { name: t("nav.home"), url: `${siteUrl}/${lang}/` },
  { name: t("nav.gallery"), url: `${siteUrl}${tp("/portfolio")}` },
];

const portfolioApi = createPortfolioApi(lang);
const portfolio = await portfolioApi.fetchPortfolioPage({ start: 0, end: 100 });

const tags = PORTFOLIO_TAG_KEYS.map((key) => ({
  key,
  label: t(`tags.${key}`),
}));
---

<Layout
  title={t("portfolio.seo.title")}
  description={t("portfolio.seo.description")}
  mainClass="bg-secondary pt-36 pb-20"
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      title={t("portfolio.title")}
      subtitle={t("portfolio.subtitle")}
      as="h1"
    />

    <TagFilter tags={tags} allLabel={t("portfolio.tagAll")} />

    <GridGallery
      images={portfolio.flatMap((project) =>
        project.images.map((image) => ({
          thumbnail: image.thumbnail,
          url: image.url,
          alt: project.title,
          title: project.title,
          description: project.description,
          date: project.date,
          tags: project.tags,
          orientation: image.aspectRatio > 1 ? "landscape" : "portrait",
        }))
      )}
    />
  </div>
</Layout>

<script>
  function setupTagFilter(): void {
    const TAG_PARAM = "tag";

    const filterEl = document.querySelector('[data-testid="tag-filter"]');
    const gallery = document.querySelector('[data-testid="gallery"]');
    const hasElements = filterEl && gallery;

    if (!hasElements) {
      return;
    }

    const tagButtons =
      filterEl.querySelectorAll<HTMLButtonElement>("[data-tag]");
    const tiles = gallery.querySelectorAll<HTMLElement>(
      "[data-testid='gallery-tile']"
    );

    function getActiveTag(): string {
      const params = new URLSearchParams(window.location.search);
      return params.get(TAG_PARAM) ?? "";
    }

    function setActiveTag(tag: string): void {
      const url = new URL(window.location.href);
      if (tag) {
        url.searchParams.set(TAG_PARAM, tag);
      } else {
        url.searchParams.delete(TAG_PARAM);
      }
      window.history.pushState({}, "", url.toString());
    }

    function updateButtonStates(activeTag: string): void {
      for (const btn of tagButtons) {
        const btnTag = btn.getAttribute("data-tag") ?? "";
        const isActive = btnTag === activeTag;
        btn.classList.toggle("tag-btn--active", isActive);
        btn.setAttribute("aria-pressed", String(isActive));
      }
    }

    function filterTiles(tag: string): void {
      for (const tile of tiles) {
        if (!tag) {
          tile.classList.remove("hidden");
          tile.style.opacity = "1";
          tile.style.transform = "none";
          continue;
        }

        const tileTags = tile.getAttribute("data-tags") ?? "";
        const matches = tileTags.split(",").includes(tag);

        if (matches) {
          tile.classList.remove("hidden");
          tile.style.opacity = "1";
          tile.style.transform = "none";
        } else {
          tile.classList.add("hidden");
        }
      }
    }

    function applyFilter(tag: string): void {
      setActiveTag(tag);
      updateButtonStates(tag);
      filterTiles(tag);
    }

    for (const btn of tagButtons) {
      btn.addEventListener("click", () => {
        const tag = btn.getAttribute("data-tag") ?? "";
        applyFilter(tag);
      });
    }

    window.addEventListener("popstate", () => {
      const tag = getActiveTag();
      updateButtonStates(tag);
      filterTiles(tag);
    });

    // Apply initial filter from URL
    const initialTag = getActiveTag();
    if (initialTag) {
      updateButtonStates(initialTag);
      filterTiles(initialTag);
    }
  }

  setupTagFilter();
  document.addEventListener("astro:page-load", setupTagFilter);
</script>
