---
import { Mail, Phone } from "@lucide/astro";
import Facebook from "simple-icons-astro/Facebook";

const currentYear = new Date().getFullYear();

// Static mock content - will be replaced with CMS data later
const content = {
  aboutText:
    "Studio Tapicerskie BERO to rodzinna firma z ponad 20-letnim doświadczeniem w renowacji i tworzeniu mebli tapicerowanych.",
  rights: `© ${currentYear} Studio Tapicerskie BERO. Wszelkie prawa zastrzeżone.`,
  phone: "+48 123 456 789",
  email: "kontakt@studiotapicerskie.pl",
};

const quickLinks = [
  { label: "Strona główna", href: "#home" },
  { label: "Realizacje", href: "#projects" },
  { label: "O nas", href: "#about" },
  { label: "Kontakt", href: "#contact" },
];

const legalLinks = [{ label: "Polityka prywatności", href: "/privacy-policy" }];

const socialLinks = [{ icon: Facebook, href: "#", label: "Facebook" }];
---

<footer class="bg-primary text-primary-foreground">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8 grid gap-8 md:grid-cols-4">
      <!-- About -->
      <div class="md:col-span-2">
        <p class="mb-4 text-sm text-primary-foreground/80">
          {content.aboutText}
        </p>
        <div class="flex space-x-4">
          {
            socialLinks.map((social) => {
              const Icon = social.icon;
              return (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-accent"
                  aria-label={social.label}
                >
                  <Icon class="h-5 w-5" />
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="mb-4 text-lg">Szybkie linki</h3>
        <ul class="space-y-2">
          {
            quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-primary-foreground/80 transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="mb-4 text-lg">Informacje prawne</h3>
        <ul class="space-y-2">
          {
            legalLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-primary-foreground/80 transition-colors hover:text-accent"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 space-y-2">
          <div
            class="flex items-center space-x-2 text-sm text-primary-foreground/80"
          >
            <Phone class="h-4 w-4" />
            <span>{content.phone}</span>
          </div>
          <div
            class="flex items-center space-x-2 text-sm text-primary-foreground/80"
          >
            <Mail class="h-4 w-4" />
            <span>{content.email}</span>
          </div>
        </div>
      </div>
    </div>

    <div
      class="border-t border-white/10 pt-8 text-center text-sm text-primary-foreground/60"
    >
      {content.rights}
    </div>
  </div>
</footer>
