---
import ServiceCard from "./ServiceCard.astro";

interface Props {
  services: {
    title: string;
    description: string;
  }[];
}

const { services } = Astro.props;
---

<div data-testid="about-services">
  <h3 data-animate="about-services-title" class="mb-12 text-center text-3xl">
    Nasze Uslugi
  </h3>
  <div
    data-animate="about-services-grid"
    class="grid gap-6 md:grid-cols-2 lg:grid-cols-4"
  >
    {services.map((service) => (
        <div data-animate="about-services-card" class="h-full">
          <ServiceCard
            title={service.title}
            description={service.description}
          />
        </div>
      ))}
  </div>
</div>

<style>
  @media (scripting: enabled) {
    [data-animate="about-services-title"] {
      opacity: 0;
      transform: translateY(20px);
    }
    [data-animate="about-services-card"] {
      opacity: 0;
      transform: translateY(30px);
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  inView("[data-animate='about-services-title']", (element) => {
    animate(element, { opacity: 1, y: 0 }, { duration: 0.6, ease: "easeOut" });
  });

  inView(
    "[data-animate='about-services-grid']",
    (grid) => {
      const cards = grid.querySelectorAll<HTMLElement>(
        "[data-animate='about-services-card']"
      );

      for (const [index, card] of cards.entries()) {
        animate(
          card,
          { opacity: 1, y: 0 },
          {
            delay: index * 0.08,
            type: "spring",
            stiffness: 480,
            damping: 20,
            mass: 1,
          }
        );
      }
    },
    { margin: "-50px" }
  );
</script>
