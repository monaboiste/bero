---
import SectionHeader from "@components/ui/SectionHeader.astro";
import { getLang, useTranslations } from "@i18n/utils";
import { Award, Clock, Heart, Users } from "@lucide/astro";
import AboutServices from "./AboutServices.astro";
import AboutStats from "./AboutStats.astro";
import StorySection from "./StorySection.astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const content = {
  craftImage:
    "https://images.unsplash.com/photo-1682718619781-252f23e21132?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjcmFmdHNtYW4lMjB3b3JraW5nJTIwZnVybml0dXJlfGVufDF8fHx8MTc3MDU3ODcxNnww&ixlib=rb-4.1.0&q=80&w=800",
};

const stats = [
  {
    icon: Clock,
    valueNumeric: 20,
    suffix: "+",
    label: t("about.stats.experience"),
  },
  {
    icon: Award,
    valueNumeric: 500,
    suffix: "+",
    label: t("about.stats.projects"),
  },
  {
    icon: Users,
    valueNumeric: 100,
    suffix: "%",
    label: t("about.stats.clients"),
  },
  {
    icon: Heart,
    suffix: "\u221E",
    label: t("about.stats.passion"),
  },
];

const services = [
  {
    title: t("about.services.renovation"),
    description: t("about.services.renovationDesc"),
  },
  {
    title: t("about.services.upholstery"),
    description: t("about.services.upholsteryDesc"),
  },
  {
    title: t("about.services.repair"),
    description: t("about.services.repairDesc"),
  },
  {
    title: t("about.services.automotive"),
    description: t("about.services.automotiveDesc"),
  },
];
---

<section id="about" data-testid="about" class="overflow-x-hidden py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader title={t("about.title")} subtitle={t("about.subtitle")} />
    <StorySection
      story={t("about.story")}
      mission={t("about.mission")}
      image={content.craftImage}
      imageAlt={t("about.craftImageAlt")}
    />
    <AboutStats stats={stats} />
    <AboutServices services={services} title={t("about.servicesTitle")} />
  </div>
</section>
