---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  story: string;
  mission: string;
  image: ImageMetadata;
  imageAlt?: string;
}

const { story, mission, image: craftImage, imageAlt = "" } = Astro.props;
---

<div
  data-testid="about-story"
  class="mb-20 grid items-center gap-12 md:grid-cols-2"
>
  <Image
    data-animate="about-story-img"
    src={craftImage}
    alt={imageAlt}
    class="h-auto w-full rounded-lg shadow-xl"
    width={800}
    height={600}
    loading="lazy"
  />
  <div data-animate="about-story-mission">
    <p class="mb-6 text-lg leading-relaxed">{story}</p>
    <p class="leading-relaxed text-muted-foreground">{mission}</p>

    <div data-animate="about-story-signature" class="mt-8">
      <span
        class="font-accent text-3xl text-accent md:text-4xl"
        style="font-family: var(--font-accent);"
      >
        Bero
      </span>
    </div>
  </div>
</div>

<style>
  @media (scripting: enabled) {
    [data-animate="about-story-img"] {
      opacity: 0;
      transform: translateX(-50px);
    }
    [data-animate="about-story-mission"] {
      opacity: 0;
      transform: translateX(50px);
    }
    [data-animate="about-story-signature"] {
      opacity: 0;
      transform: scale(0.8);
    }
  }
</style>

<script>
  import { animate, inView } from "motion";

  inView(
    "[data-animate='about-story-img']",
    (element) => {
      animate(element, { opacity: 1, x: 0 }, { duration: 0.8 });
    },
    { margin: "-100px" }
  );
  inView(
    "[data-animate='about-story-mission']",
    (element) => {
      animate(element, { opacity: 1, x: 0 }, { duration: 0.8, delay: 0.2 });
    },
    { margin: "-100px" }
  );
  inView("[data-animate='about-story-signature']", (element) => {
    animate(element, { opacity: 1, scale: 1 }, { duration: 0.6, delay: 0.4 });
  });
</script>
