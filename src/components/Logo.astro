---
import { Image } from "astro:assets";
import logoDark from "../assets/logo/chair-dark.png";
import logoLight from "../assets/logo/chair-white.png";

interface Props {
  variant?: "light" | "dark";
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { variant = "light", size = "md", class: className = "" } = Astro.props;

// Size presets — image, text, and separator dimensions per size
const sizes = {
  sm: {
    main: "0.75rem",
    bero: "0.5rem",
    separator: "2.25rem",
    gap: "0.125rem",
    imageHeight: "h-9", // 36px — fits h-20 nav with padding
    imageWidth: 120,
    containerGap: "gap-2",
    separatorMargin: "mr-2",
  },
  md: {
    main: "1.25rem",
    bero: "0.875rem",
    separator: "3.25rem",
    gap: "0.25rem",
    imageHeight: "h-12", // 48px
    imageWidth: 180,
    containerGap: "gap-3",
    separatorMargin: "mr-3",
  },
  lg: {
    main: "2rem",
    bero: "1.5rem",
    separator: "5rem",
    gap: "0.5rem",
    imageHeight: "h-20", // 80px
    imageWidth: 280,
    containerGap: "gap-4",
    separatorMargin: "mr-4",
  },
};

const sizeScheme = sizes[size];

// Tailwind classes for text colors based on variant
let studioClass = "";
let tapicerskieClass = "";
let beroClass = "";
let separatorClass = "";

if (variant === "light") {
  studioClass = "text-foreground";
  tapicerskieClass = "text-accent";
  beroClass = "text-foreground";
  separatorClass = "bg-foreground";
} else if (variant === "dark") {
  studioClass = "text-background";
  tapicerskieClass = "text-accent";
  beroClass = "text-background";
  separatorClass = "bg-background";
}
---

<a
  href="#home"
  class={`shrink-0 ${className} flex items-center ${sizeScheme.containerGap}`}
>
  <!-- Logo Image -->
  <div class="flex-shrink-0">
    <Image
      src={logoLight}
      alt="BERO"
      class={`${sizeScheme.imageHeight} w-auto dark:hidden`}
      width={sizeScheme.imageWidth}
      format="webp"
      quality={48}
    />
    <Image
      src={logoDark}
      alt="BERO"
      class={`hidden ${sizeScheme.imageHeight} w-auto dark:block`}
      width={sizeScheme.imageWidth}
      format="webp"
      quality={48}
    />
  </div>

  <!-- Logo Text -->
  <div
    class="inline-flex items-center"
    style={{ fontFamily: "var(--font-sans)" }}
  >
    <!-- Vertical separator line -->
    <div
      class={`${sizeScheme.separatorMargin} ${separatorClass}`}
      style={{
        width: "1px",
        height: `${sizeScheme.separator}`,
        opacity: 0.3,
        flexShrink: 0,
      }}
    ></div>

    <!-- Text content -->
    <div class="flex flex-col" style={{ gap: `${sizeScheme.gap}` }}>
      <!-- "studio tapicerskie" - inline -->
      <div
        style={{ fontSize: `${sizeScheme.main}`, lineHeight: 1, letterSpacing: "-0.02em" }}
      >
        <span
          class={studioClass}
          style={{ fontWeight: 'var(--font-weight-normal)' }}
          >studio
        </span><span
          class={tapicerskieClass}
          style={{ fontWeight: 'var(--font-weight-medium)' }}
          >tapicerskie</span
        >
      </div>

      <!-- "BERO" - Bold, Uppercase -->
      <div
        class={beroClass}
        style={{
          fontSize: `${sizeScheme.bero}`,
          fontWeight: 'var(--font-weight-medium)',
          lineHeight: 1,
          letterSpacing: "0.1em",
        }}
      >
        BERO
      </div>
    </div>
  </div>
</a>
