---
import { getLang, useTranslatedPath, useTranslations } from "@i18n/utils";
import { ArrowRight } from "@lucide/astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);

// TODO: replace this unspash image
const heroImage =
  "https://images.unsplash.com/photo-1763979628017-ea650631b0be?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxsdXh1cnklMjBmdXJuaXR1cmUlMjB1cGhvbHN0ZXJ5fGVufDF8fHx8MTc3MDU3ODcxNXww&ixlib=rb-4.1.0&q=80&w=1920";
---

<section
  id="home"
  data-testid="hero"
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-20"
>
  <div data-animate="hero-image" class="absolute inset-0 z-0">
    <img
      src={heroImage}
      alt={t("hero.imageAlt")}
      class="h-full w-full object-cover"
      width="1920"
      height="1080"
    >
    <div
      class="absolute inset-0 bg-linear-to-r from-black/80 via-black/60 to-black/40"
    ></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h1
        data-testid="hero-title"
        data-animate="hero-title"
        class="mb-6 text-5xl font-bold text-white md:text-7xl"
      >
        {t("hero.title")}
      </h1>

      <p
        data-animate="hero-description"
        class="mb-8 text-xl leading-relaxed text-gray-200 md:text-2xl"
      >
        {t("hero.description")}
      </p>

      <div
        data-animate="hero-cta"
        class="flex flex-col items-center gap-4 sm:items-start sm:flex-row"
      >
        <a
          href={tp("/#contact")}
          data-testid="hero-cta-primary"
          class="w-full sm:w-auto group flex items-center justify-center space-x-2 rounded-lg bg-accent px-8 py-4 text-white shadow-lg transition-all duration-300 hover:bg-accent/90 hover:shadow-xl"
        >
          <span>{t("hero.cta")}</span>
          <ArrowRight
            class="h-5 w-5 transition-transform group-hover:translate-x-1"
          />
        </a>

        <a
          href={tp("/#projects")}
          data-testid="hero-cta-secondary"
          class="w-full sm:w-auto flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-8 py-4 text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/20"
        >
          {t("hero.featured")}
        </a>
      </div>
    </div>
  </div>

  <div
    class="pointer-events-none absolute right-0 bottom-0 left-0 z-10 h-32 bg-linear-to-t from-background to-transparent"
  ></div>
</section>

<style>
  @media (scripting: enabled) {
    [data-animate="hero-title"],
    [data-animate="hero-description"] {
      opacity: 0;
      transform: translateX(-50px);
    }
    [data-animate="hero-cta"] {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>

<script>
  import { animate } from "motion";

  animate(
    "[data-animate='hero-image']",
    { scale: [1.1, 1] },
    { duration: 1.5 }
  );
  animate(
    "[data-animate='hero-title']",
    { opacity: 1, x: 1 },
    { duration: 0.8, delay: 0.4 }
  );
  animate(
    "[data-animate='hero-description']",
    { opacity: 1, x: 1 },
    { duration: 0.5, delay: 0.6 }
  );
  animate(
    "[data-animate='hero-cta']",
    { opacity: 1, y: 0 },
    { duration: 0.6, delay: 0.8 }
  );
</script>
