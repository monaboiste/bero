---
import { Image } from "astro:assets";
import heroImage from "@assets/hero.webp";
import { getLang, useTranslations } from "@i18n/locale";
import { useTranslatedPath } from "@i18n/path";
import { useRichText } from "@i18n/richtext";
import { ArrowRight } from "@lucide/astro";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const richText = useRichText(lang);
---

<section
  id="home"
  data-testid="hero"
  class="relative flex min-h-screen items-center justify-center overflow-hidden pt-20"
>
  <div
    data-animate="hero-image"
    class="absolute top-0 left-0 bottom-0 z-0 w-full h-full"
  >
    <Image
      src={heroImage}
      alt={t("hero.imageAlt")}
      class="h-full w-full object-cover object-[15%] md:object-left"
      loading="eager"
      format="webp"
      widths={[640, 1024, 1600, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-black/60 md:bg-transparent"></div>
    <div
      class="absolute inset-0 bg-linear-to-l from-black/90 via-black/40 to-transparent"
    ></div>
  </div>

  <div
    class="relative z-10 w-full md:ml-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8"
  >
    <div class="max-w-3xl md:ml-auto md:pr-12 lg:pr-24">
      <h1
        data-testid="hero-title"
        data-animate="hero-title"
        class="mb-6 text-3xl font-bold text-white sm:text-5xl md:text-7xl"
      >
        {richText("hero.title", ["accent"]).map((part) =>
          part.tag === "accent"
            ? <span class="text-accent">{part.text}</span>
            : part.text
        )}
      </h1>

      <p
        data-animate="hero-description"
        class="mb-8 text-base leading-relaxed text-gray-200 sm:text-xl md:text-2xl"
      >
        {t("hero.description")}
      </p>

      <div
        data-animate="hero-cta"
        class="flex flex-col items-center gap-4 sm:flex-row sm:items-end"
      >
        <a
          href={tp("/#contact")}
          data-testid="hero-cta-primary"
          class="w-full sm:w-auto group flex items-center justify-center space-x-2 rounded-lg bg-accent px-6 py-3 sm:px-8 sm:py-4 text-white shadow-lg transition-all duration-300 hover:bg-accent/90 hover:shadow-xl"
        >
          <span>{t("hero.cta")}</span>
          <ArrowRight
            class="h-5 w-5 transition-transform group-hover:translate-x-1"
          />
        </a>

        <a
          href={tp("/#projects")}
          data-testid="hero-cta-secondary"
          class="w-full sm:w-auto flex items-center justify-center rounded-lg border border-white/30 bg-white/10 px-6 py-3 sm:px-8 sm:py-4 text-white backdrop-blur-sm transition-all duration-300 hover:bg-white/20"
        >
          {t("hero.featured")}
        </a>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 h-48 bg-linear-to-t from-secondary via-secondary/50 to-transparent z-10 pointer-events-none"
  ></div>
</section>

<style>
  @media (scripting: enabled) {
    [data-animate="hero-title"],
    [data-animate="hero-description"] {
      opacity: 0;
      transform: translateX(-50px);
    }
    [data-animate="hero-cta"] {
      opacity: 0;
      transform: translateY(20px);
    }
  }
</style>

<script>
  import { animate } from "motion";

  animate(
    "[data-animate='hero-image']",
    { scale: [1.1, 1] },
    { duration: 1.5 }
  );
  animate(
    "[data-animate='hero-title']",
    { opacity: 1, x: 1 },
    { duration: 0.8, delay: 0.4 }
  );
  animate(
    "[data-animate='hero-description']",
    { opacity: 1, x: 1 },
    { duration: 0.5, delay: 0.6 }
  );
  animate(
    "[data-animate='hero-cta']",
    { opacity: 1, y: 0 },
    { duration: 0.6, delay: 0.8 }
  );
</script>
