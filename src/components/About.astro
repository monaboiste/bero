---
import { Award, Clock, Heart, Users } from "@lucide/astro";

// Static mock content - will be replaced with CMS data later
const content = {
  title: "O Nas",
  subtitle: "Pasja i doświadczenie w każdym projekcie",
  story:
    "Studio Tapicerskie BERO to rodzinna firma z ponad 20-letnim doświadczeniem w branży tapicerskiej. Specjalizujemy się w profesjonalnej renowacji i tworzeniu mebli tapicerowanych, łącząc tradycyjne rzemiosło z nowoczesnymi technikami.",
  mission:
    "Naszą misją jest przywracanie piękna i funkcjonalności ulubionym meblom naszych klientów. Każdy projekt traktujemy indywidualnie, dbając o najdrobniejsze szczegóły.",
  craftImage:
    "https://images.unsplash.com/photo-1682718619781-252f23e21132?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjcmFmdHNtYW4lMjB3b3JraW5nJTIwZnVybml0dXJlfGVufDF8fHx8MTc3MDU3ODcxNnww&ixlib=rb-4.1.0&q=80&w=800",
};

const stats = [
  { icon: Clock, value: "20+", label: "Lat doświadczenia" },
  { icon: Award, value: "500+", label: "Zrealizowanych projektów" },
  { icon: Users, value: "100%", label: "Zadowolonych klientów" },
  { icon: Heart, value: "∞", label: "Pasja w każdym detalu" },
];

const services = [
  {
    title: "Renowacja mebli",
    description:
      "Przywracamy życie starym meblom i wydobywamy ich dawny charakter",
  },
  {
    title: "Wymiana tapicerki",
    description:
      "Odświeżamy wygląd mebli, dobierając tkaniny dopasowane do wnętrza",
  },
  {
    title: "Naprawa konstrukcji",
    description: "Wzmacniamy stelaże i przywracamy pełną stabilność mebli",
  },
  {
    title: "Tapicerstwo samochodowe",
    description:
      "Regeneracja foteli i podsufitek – estetyka wnętrza jak z salonu",
  },
];
---

<section id="about" class="py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-4xl md:text-5xl">{content.title}</h2>
      <p class="text-xl text-muted-foreground">{content.subtitle}</p>
    </div>

    <!-- Story Section -->
    <div class="mb-20 grid items-center gap-12 md:grid-cols-2">
      <div>
        <img
          src={content.craftImage}
          alt="Craftsman working"
          class="h-auto w-full rounded-lg shadow-xl"
          width="800"
          height="600"
          loading="lazy"
        />
      </div>
      <div>
        <p class="mb-6 text-lg leading-relaxed">{content.story}</p>
        <p class="leading-relaxed text-muted-foreground">{content.mission}</p>

        <div class="mt-8">
          <span
            class="font-accent text-3xl text-accent italic md:text-4xl"
            style="font-family: var(--font-accent);"
          >
            BERO
          </span>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="mb-20 grid grid-cols-2 gap-8 md:grid-cols-4">
      {
        stats.map((stat) => {
          const Icon = stat.icon;
          return (
            <div class="text-center">
              <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full bg-accent/10">
                <Icon class="h-8 w-8 text-accent" />
              </div>
              <div class="mb-2 text-4xl">{stat.value}</div>
              <div class="text-sm text-muted-foreground">{stat.label}</div>
            </div>
          );
        })
      }
    </div>

    <!-- Services -->
    <div>
      <h3 class="mb-12 text-center text-3xl">Nasze Usługi</h3>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <div class="rounded-lg border border-border bg-card p-6 transition-all duration-300 hover:border-accent hover:shadow-lg">
              <div class="mb-4 h-1 w-12 bg-accent" />
              <h4 class="mb-3 text-xl">{service.title}</h4>
              <p class="text-muted-foreground">{service.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
