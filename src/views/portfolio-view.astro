---
import { PortfolioGallery } from "@components/portfolio/portfolio-gallery";
import { getTranslations, type Lang } from "@i18n/locale";
import MainLayout from "@layouts/main-layout.astro";
import { createPortfolioApi } from "@lib/content/content";
import { PORTFOLIO_TAG_KEYS } from "@lib/content/tags";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

const portfolioApi = createPortfolioApi(lang);
const portfolio = await portfolioApi.fetchPortfolioPage({ start: 0, end: 100 });

const tags = PORTFOLIO_TAG_KEYS.map((key) => ({
  key,
  label: t(`tags.${key}`),
}));

const images = portfolio.flatMap((project) =>
  project.images.map((image) => ({
    thumbnail: {
      src: image.thumbnail,
      alt: project.title,
      width: 800,
      height: Math.round(800 / image.aspectRatio),
    },
    url: image.url,
    title: project.title,
    description: project.description,
    date: project.date,
    tags: project.tags,
    orientation: (image.aspectRatio > 1 ? "landscape" : "portrait") as
      | "landscape"
      | "portrait",
  }))
);

// Light props for React (no heavy description/date text)
const tileImages = images.map(({ description, date, ...tile }) => tile);

const initialTag = Astro.url.searchParams.get("tag") ?? "";
---

<MainLayout
  title={t("portfolio.seo.title")}
  description={t("portfolio.seo.description")}
  mainClass="bg-secondary pt-36 pb-20"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <PortfolioGallery
      client:visible
      lang={lang}
      images={tileImages}
      tags={tags}
      initialTag={initialTag}
    />
  </div>

  <!-- Static descriptions template - not duplicated in React props -->
  <template id="gallery-descriptions">
    {images.map((image) => (
      <div data-url={image.url}>
        <div class="lightbox-desc-header">
          <h4 class="lightbox-desc-title">{image.title}</h4>
          {image.date && <span class="lightbox-desc-date">{image.date.slice(0, 7)}</span>}
        </div>
        <p class="lightbox-desc-text">{image.description}</p>
      </div>
    ))}
  </template>
</MainLayout>
