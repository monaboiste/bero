---
import SectionHeader from "@components/ui/SectionHeader.astro";
import { getTranslations, type Lang } from "@i18n/locale";
import Layout from "@layouts/Layout.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<Layout
  title={`${t("privacy.title")} | ${t("seo.title")}`}
  description={t("privacy.description")}
  mainClass="bg-secondary pt-36 pb-20"
>
  <article
    data-testid="privacy-policy"
    class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8"
  >
    <SectionHeader title={t("privacy.title")} as="h1" />

    <p class="text-center text-lg leading-relaxed text-muted-foreground">
      {t("privacy.body")}
    </p>
  </article>
</Layout>
