{
  "name": "bero",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "check": "npm run check --workspaces",
    "clean": "npm run clean --workspace=apps/web",
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "preview": "npm run preview --workspace=apps/web",
    "deploy:preview": "npm run deploy:preview --workspace=apps/web",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:doc": "rumdl check",
    "lint:doc:fix": "rumdl fmt",
    "test:unit": "npm run test:unit --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,astro}": [
      "ultracite fix"
    ],
    "*.md": [
      "rumdl fmt"
    ]
  },
  "overrides": {
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "rumdl": "^0.2.3",
    "ultracite": "^7.1.1"
  }
}
