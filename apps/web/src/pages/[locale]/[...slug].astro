---
import { getLang, locales } from "@bero/locales";
import { routes } from "@i18n/routes";
import PortfolioView from "@views/portfolio-view.astro";
import PrivacyPolicyView from "@views/privacy-policy-view.astro";

export const prerender = true;

export function getStaticPaths() {
  return locales.flatMap((locale) => {
    const langRoutes = routes[locale];
    return Object.entries(langRoutes).map(([routeKey, { slug }]) => ({
      params: { locale, slug },
      props: { routeKey },
    }));
  });
}

const { routeKey } = Astro.props;
const lang = getLang(Astro.currentLocale);
---

{routeKey === "portfolio" && <PortfolioView lang={lang} />}
{routeKey === "privacy-policy" && <PrivacyPolicyView lang={lang} />}
