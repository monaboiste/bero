---
import type { BreadcrumbItem } from "@i18n/breadcrumbs";
import { getSiteUrl } from "@i18n/path";
import { BUSINESS, BUSINESS_SOCIAL_URLS } from "@lib/content/business";
import type {
  BreadcrumbList,
  Graph,
  HomeAndConstructionBusiness,
  Organization,
  Thing,
  WebSite,
} from "schema-dts";

interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs } = Astro.props;

const siteUrl = getSiteUrl(Astro.site);

const organization: Organization = {
  "@type": "Organization",
  name: BUSINESS.name,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  sameAs: [...BUSINESS_SOCIAL_URLS],
};

const localBusiness: HomeAndConstructionBusiness = {
  "@type": "HomeAndConstructionBusiness",
  name: BUSINESS.name,
  url: siteUrl,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: BUSINESS.address.street,
    addressLocality: BUSINESS.address.city,
    postalCode: BUSINESS.address.postalCode,
    addressCountry: BUSINESS.address.country,
  },
  areaServed: BUSINESS.address.locality,
  geo: {
    "@type": "GeoCoordinates",
    latitude: BUSINESS.geo.latitude,
    longitude: BUSINESS.geo.longitude,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "https://schema.org/Monday",
      "https://schema.org/Tuesday",
      "https://schema.org/Wednesday",
      "https://schema.org/Thursday",
      "https://schema.org/Friday",
    ],
    opens: "09:00",
    closes: "17:00",
  },
  priceRange: BUSINESS.priceRange,
  logo: `${siteUrl}/favicon.svg`,
  image: `${siteUrl}/seo-image.png`,
  sameAs: [...BUSINESS_SOCIAL_URLS],
};

const website: WebSite = {
  "@type": "WebSite",
  name: BUSINESS.name,
  url: siteUrl,
};

const breadcrumbList: BreadcrumbList | null = breadcrumbs
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem" as const,
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : null;

const graph: Thing[] = [organization];

if (!breadcrumbs) {
  graph.push(localBusiness, website);
}

if (breadcrumbList) {
  graph.push(breadcrumbList);
}

const jsonLd: Graph = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd)}
/>
